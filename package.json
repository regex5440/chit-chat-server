{
  "name": "chat-chat-server",
  "version": "1.0.0",
  "description": "Mock server for chit-chat app",
  "main": "build/server.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && esbuild server.ts --bundle --platform=node --outdir=build --minify",
    "static": "node build/server.js",
    "start": "nodemon -r tsconfig-paths/register --exec tsx server.ts",
    "prepare": "npx husky",
    "lint": "eslint . && prettier --check .",
    "type-check": "tsc",
    "format": "eslint . --fix",
    "buildImage": "docker build -t harshdagar/chit-chat-server .",
    "runImage": "docker compose up -d"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*": [
      "prettier --write",
      "eslint"
    ]
  },
  "author": "Harsh Dagar",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@socket.io/cluster-adapter": "^0.3.0",
    "@socket.io/sticky": "^1.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "exec": "node -r tsconfig-paths/register -r ts-node/register server.ts",
    "ext": "ts, js"
  }
}
